# ===========================================================================
# Uploaded files are NOT served directly.
#
# Customer photos, house photos and Aadhaar copies are personal data, so they
# are streamed through the application (GET /media/...) which checks the session
# and the caller's branch scope first. Direct access is denied here so that
# guessing a filename cannot leak a borrower's Aadhaar image.
# ===========================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Belt and braces: never execute anything in here, whatever the extension.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .cgi .asp .jsp
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8

Options -Indexes -ExecCGI
