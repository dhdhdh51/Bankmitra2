<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up. The app holds borrower personal data and session
    tokens, neither of which should leave the device in a cloud backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
