<?xml version="1.0" encoding="utf-8"?>
<!--
    The KCC/OD-2 badge on a lead row - the same navy the status chip's "promise"
    state uses, not the NPA badge's red, since a facility is a category and not a
    warning.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/lrms_primary_light" />
    <corners android:radius="4dp" />
    <stroke android:width="1dp" android:color="@color/lrms_primary_dark" />
</shape>
