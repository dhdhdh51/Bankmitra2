<?xml version="1.0" encoding="utf-8"?>
<!--
    D2 launcher mark: white "D" with a rising bar chart in its bowl, a gold "2",
    and a gold recovery arrow sweeping beneath both.

    GEOMETRY - read this before moving anything.

    An adaptive icon is drawn on a 108dp canvas, but the launcher masks it. The
    only region guaranteed to survive every mask is a 66dp circle in the middle:
    radius 33 around (54,54). Corners of a bounding box are much further from the
    centre than their edges, which is easy to forget - an earlier version of this
    file claimed to respect the safe zone while putting the top of the 2 at r=42
    and the foot of a shield at r=39, so a circular launcher cut both off.

    tools/check-icon-safezone.py measures every point (including Bezier control
    points) and fails the build if anything leaves the circle. Run it after any
    edit here.

    The letters keep their original outlines and are placed by a uniform-scale
    <group>, so nothing is squashed and the whole block can be re-fitted by
    changing two numbers instead of redrawing curves.

    A shield-and-tick used to sit at the lower right. It was removed, not
    shrunk: three motifs plus two letters cannot fit inside a 66dp circle, and it
    was overlapping the foot of the 2 and colliding with the arrowhead. At 48dp
    on a phone the tick inside it was never going to be legible anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Recovery arrow, as a rising underline beneath the letters.

        It was first drawn as a crescent wrapping around under both letters and
        curling up the right side. That put its head in the same few dp as the
        foot of the 2 no matter how the angle was tuned, so the two shapes merged
        into an unreadable wedge - the mark has to work at 48dp, where 3dp of
        overlap is a smudge. A straight rising bar sits in its own band under the
        letters and still reads as growth.
    -->
    <path
        android:fillColor="#F2B21C"
        android:pathData="M34,73L66,64L67.3,68.3L35.3,77.3Z" />
    <!-- Head, aimed along the bar's own direction (0.963,-0.271) so the joint
         does not look kinked, and clear of the 2 above it. -->
    <path
        android:fillColor="#F2B21C"
        android:pathData="M77.2,63.2L68,71L65.3,61.3Z" />

    <!--
        Letters. Uniform scale 0.714 with translate (12, 11.4) maps the original
        28..90 x 26..68 outlines onto 32..76 x 30..60, whose furthest corner sits
        at r=31.3 - inside the 33 limit with a little to spare.
    -->
    <group
        android:scaleX="0.714"
        android:scaleY="0.714"
        android:translateX="12"
        android:translateY="11.4">

        <!-- White D. The second subpath cuts the bowl out of the first. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M28,26h14c12,0 20,8 20,21c0,13 -8,21 -20,21h-14V26zM36,34v26h5c8,0 13,-5 13,-13c0,-8 -5,-13 -13,-13z" />

        <!-- Bar chart inside the bowl of the D: three rising columns. Reads as
             recovery progress at icon size, where finer detail would turn to mud. -->
        <path
            android:fillColor="#2C6BD4"
            android:pathData="M39,52h3v8h-3zM44,47h3v13h-3zM49,41h3v19h-3z" />

        <!-- Gold 2 -->
        <path
            android:fillColor="#F2B21C"
            android:pathData="M64,34c2,-5 7,-8 13,-8c8,0 13,5 13,12c0,5 -3,9 -8,14l-10,10h19v6H63v-5l15,-15c4,-4 5,-6 5,-9c0,-4 -3,-6 -6,-6c-4,0 -6,2 -7,6z" />
    </group>
</vector>
